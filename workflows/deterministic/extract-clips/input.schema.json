{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "master": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "artifactId",
        "version"
      ]
    },
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clipId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "standaloneConfirmed": {
            "const": true
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "clipId",
          "start",
          "end",
          "standaloneConfirmed",
          "purpose"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "master",
    "clips"
  ]
}
