{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive-influencer-ops.local/workflows/draft-presenter-script/1.2.0/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["production_id", "vehicle", "sources", "candidate_facts", "editorial_brief", "constraints"],
  "properties": {
    "production_id": { "type": "string", "pattern": "^prd_[a-zA-Z0-9_-]+$" },
    "vehicle": {
      "type": "object", "additionalProperties": false,
      "required": ["vehicle_id", "year", "make", "model", "trim", "market"],
      "properties": {
        "vehicle_id": { "type": "string", "pattern": "^veh_[a-zA-Z0-9_-]+$" },
        "year": { "type": "integer", "minimum": 1886, "maximum": 2100 },
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "trim": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "pattern": "^[A-Z]{2,3}$" }
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "title", "publisher", "url", "retrieved_on", "source_type"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "retrieved_on": { "type": "string", "format": "date" },
          "source_type": { "enum": ["manufacturer_official", "government", "dealer", "other"] }
        }
      }
    },
    "candidate_facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["candidate_fact_id", "label", "value", "unit", "source_ids", "verification_status"],
        "properties": {
          "candidate_fact_id": { "type": "string", "pattern": "^candidate_[a-zA-Z0-9_-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "value": { "type": ["string", "number", "boolean"] },
          "unit": { "type": ["string", "null"] },
          "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
          "verification_status": { "const": "CANDIDATE" }
        }
      }
    },
    "editorial_brief": {
      "type": "object", "additionalProperties": false,
      "required": ["audience", "angle", "tone", "target_duration_seconds", "target_clip_count"],
      "properties": {
        "audience": { "type": "string", "minLength": 1 },
        "angle": { "type": "string", "minLength": 1 },
        "tone": { "type": "string", "minLength": 1 },
        "target_duration_seconds": { "type": "integer", "minimum": 15, "maximum": 600 },
        "target_clip_count": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "constraints": {
      "type": "object", "additionalProperties": false,
      "required": ["language", "format", "prohibited_claims", "contact_method"],
      "properties": {
        "language": { "const": "es" },
        "format": { "const": "vertical_video" },
        "prohibited_claims": { "type": "array", "items": { "type": "string" } },
        "contact_method": { "type": ["string", "null"], "minLength": 1 }
      }
    }
  }
}
