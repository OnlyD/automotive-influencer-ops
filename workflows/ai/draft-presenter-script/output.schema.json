{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive-influencer-ops.local/workflows/draft-presenter-script/1.2.0/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["production_id", "workflow", "script", "candidate_fact_usage", "sources_used", "technical_review_required", "publishable", "warnings"],
  "properties": {
    "production_id": { "type": "string", "pattern": "^prd_[a-zA-Z0-9_-]+$" },
    "workflow": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "draft-presenter-script" }, "version": { "const": "1.2.0" } } },
    "script": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "target_duration_seconds", "blocks", "closing_cta"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "target_duration_seconds": { "type": "integer", "minimum": 15, "maximum": 600 },
        "blocks": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "target_range_seconds", "spoken_text", "on_screen_text", "shot_intent", "candidate_fact_refs", "source_refs", "clip_candidate"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
              "target_range_seconds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer", "minimum": 0 } },
              "spoken_text": { "type": "string", "minLength": 1 },
              "on_screen_text": { "type": ["string", "null"] },
              "shot_intent": { "type": "string", "minLength": 1 },
              "candidate_fact_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^candidate_[a-zA-Z0-9_-]+$" } },
              "source_refs": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
              "clip_candidate": { "type": "boolean" }
            }
          }
        },
        "closing_cta": { "type": "object", "additionalProperties": false, "required": ["contact_text", "engagement_text"], "properties": { "contact_text": { "type": "string", "minLength": 1 }, "engagement_text": { "type": "string", "minLength": 1 } } }
      }
    },
    "candidate_fact_usage": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["candidate_fact_id", "used_in_blocks"], "properties": { "candidate_fact_id": { "type": "string", "pattern": "^candidate_[a-zA-Z0-9_-]+$" }, "used_in_blocks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } } } } },
    "sources_used": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
    "technical_review_required": { "const": true },
    "publishable": { "const": false },
    "warnings": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
