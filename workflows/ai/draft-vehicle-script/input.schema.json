{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive-influencer-ops.local/workflows/draft-vehicle-script/1.0.0/input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["production_id", "vehicle", "verified_facts", "editorial_brief", "commercial_context", "constraints"],
  "properties": {
    "production_id": { "type": "string", "pattern": "^prd_[a-zA-Z0-9_-]+$" },
    "vehicle": { "type": "object", "additionalProperties": false, "required": ["vehicle_id", "year", "make", "model", "trim", "market"], "properties": {
      "vehicle_id": { "type": "string", "pattern": "^veh_[a-zA-Z0-9_-]+$" }, "year": { "type": "integer", "minimum": 1886, "maximum": 2100 },
      "make": { "type": "string", "minLength": 1 }, "model": { "type": "string", "minLength": 1 }, "trim": { "type": "string", "minLength": 1 }, "market": { "type": "string", "pattern": "^[A-Z]{2,3}$" }
    } },
    "verified_facts": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["fact_id", "label", "value", "unit", "source_ids", "verification_status"], "properties": {
      "fact_id": { "type": "string", "pattern": "^fact_[a-zA-Z0-9_-]+$" }, "label": { "type": "string", "minLength": 1 },
      "value": { "type": ["string", "number", "boolean", "array", "object"] }, "unit": { "type": ["string", "null"] },
      "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
      "verification_status": { "const": "VERIFIED" }
    } } },
    "editorial_brief": { "type": "object", "additionalProperties": false, "required": ["audience", "angle", "tone", "target_duration_seconds", "target_clip_count"], "properties": {
      "audience": { "type": "string", "minLength": 1 }, "angle": { "type": "string", "minLength": 1 }, "tone": { "type": "string", "minLength": 1 },
      "target_duration_seconds": { "type": "integer", "minimum": 15, "maximum": 600 }, "target_clip_count": { "type": "integer", "minimum": 0, "maximum": 30 }
    } },
    "commercial_context": { "type": "object", "additionalProperties": false, "required": ["include_price", "include_availability", "include_financing", "approved_claims"], "properties": {
      "include_price": { "type": "boolean" }, "include_availability": { "type": "boolean" }, "include_financing": { "type": "boolean" },
      "approved_claims": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "text", "source_ids"], "properties": {
        "kind": { "enum": ["price", "availability", "promotion", "financing"] }, "text": { "type": "string", "minLength": 1 }, "source_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } }
      } }
    } } },
    "constraints": { "type": "object", "additionalProperties": false, "required": ["language", "format", "prohibited_claims", "cta_destination"], "properties": {
      "language": { "const": "es" }, "format": { "const": "vertical_video" }, "prohibited_claims": { "type": "array", "items": { "type": "string" } },
      "cta_destination": { "enum": ["PROFILE_OR_MAIN_VIDEO", "NONE"] }
    } }
  }
}
