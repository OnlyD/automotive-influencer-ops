{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive-influencer-ops.local/workflows/research-vehicle/1.1.0/input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["vehicle", "research_brief"],
  "properties": {
    "vehicle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vehicle_id", "year", "make", "model", "trim", "market"],
      "properties": {
        "vehicle_id": { "type": "string", "pattern": "^veh_[a-zA-Z0-9_-]+$" },
        "year": { "type": "integer", "minimum": 1886, "maximum": 2100 },
        "make": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "trim": { "type": "string", "minLength": 1 },
        "market": { "type": "string", "pattern": "^[A-Z]{2,3}$" }
      }
    },
    "research_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "requested_fields", "as_of"],
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "requested_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "as_of": { "type": "string", "format": "date-time" }
      }
    }
  }
}
