{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive-influencer-ops.local/workflows/validate-vehicle-data/1.0.0/output.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["workflow", "vehicle_id", "proposals", "review_required", "warnings"],
  "properties": {
    "workflow": { "type": "object", "additionalProperties": false, "required": ["id", "version"], "properties": { "id": { "const": "validate-vehicle-data" }, "version": { "const": "1.0.0" } } },
    "vehicle_id": { "type": "string", "pattern": "^veh_[a-zA-Z0-9_-]+$" },
    "proposals": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["candidate_fact_id", "proposed_status", "supporting_source_ids", "opposing_source_ids", "evidence_summary", "reviewer_checklist"], "properties": {
      "candidate_fact_id": { "type": "string", "pattern": "^candidate_[a-zA-Z0-9_-]+$" },
      "proposed_status": { "enum": ["VERIFIED", "CONFLICTED", "IN_REVIEW"] },
      "supporting_source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
      "opposing_source_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^src_[a-zA-Z0-9_-]+$" } },
      "evidence_summary": { "type": "string", "minLength": 1 },
      "reviewer_checklist": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
    } } },
    "review_required": { "const": true },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
