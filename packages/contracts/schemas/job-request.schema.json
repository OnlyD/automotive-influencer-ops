{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive.example.invalid/job-request/1.0.0",
  "title": "job-request@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "workflowId": {
      "type": "string",
      "enum": [
        "create-shooting-plan",
        "render-video",
        "extract-clips",
        "prepare-publication-package"
      ]
    },
    "workflowVersion": {
      "const": "1.0.0"
    },
    "productionId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    }
  },
  "required": [
    "workflowId",
    "workflowVersion",
    "productionId",
    "idempotencyKey",
    "input"
  ]
}
