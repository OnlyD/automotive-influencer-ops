{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive.example.invalid/job/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "jobId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "workflowId": {
      "type": "string",
      "enum": [
        "create-shooting-plan",
        "render-video",
        "extract-clips",
        "prepare-publication-package"
      ]
    },
    "workflowVersion": {
      "const": "1.0.0"
    },
    "productionId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "type": "object"
    },
    "requestHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "requestedBy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "presenter",
            "technical-operator",
            "worker"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "role",
        "name"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "QUEUED",
        "CLAIMED",
        "RUNNING",
        "VALIDATING",
        "COMPLETED",
        "FAILED",
        "RETRY_PENDING",
        "DEAD_LETTER"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1
    },
    "leaseToken": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "leaseOwner": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "leaseExpiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "availableAt": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "artifactId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "artifactId",
          "version"
        ]
      },
      "minItems": 0
    },
    "error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "jobId",
    "workflowId",
    "workflowVersion",
    "productionId",
    "idempotencyKey",
    "input",
    "requestHash",
    "requestedBy",
    "status",
    "attempt",
    "maxAttempts",
    "leaseToken",
    "leaseOwner",
    "leaseExpiresAt",
    "availableAt",
    "result",
    "error"
  ]
}
