{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive.example.invalid/render-plan/1.0.0",
  "title": "render-plan@1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scriptId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "scriptVersion": {
      "type": "integer",
      "minimum": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "assetId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "sceneId": {
            "type": "string",
            "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
          }
        },
        "required": [
          "assetId",
          "start",
          "end",
          "sceneId"
        ]
      },
      "minItems": 1
    },
    "audioMode": {
      "type": "string",
      "enum": [
        "SOURCE",
        "VOICE_OVER"
      ]
    },
    "voiceoverAssetId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "start",
          "end",
          "text"
        ]
      },
      "minItems": 0
    },
    "burnSubtitles": {
      "type": "boolean"
    }
  },
  "required": [
    "scriptId",
    "scriptVersion",
    "segments",
    "audioMode",
    "voiceoverAssetId",
    "subtitles",
    "burnSubtitles"
  ]
}
