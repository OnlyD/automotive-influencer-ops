{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://automotive.example.invalid/metric-snapshot/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "snapshotId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "publicationId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9_-]{0,95}$"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "windowHours": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "definition": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "denominator": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "definition",
          "value",
          "denominator"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "snapshotId",
    "publicationId",
    "capturedAt",
    "windowHours",
    "metrics"
  ]
}
